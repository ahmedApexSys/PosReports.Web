<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the reports SPA.

  Without this, refreshing on any route other than the root returns
  "404 - File or directory not found": the browser asks IIS for /report/salesPeriod
  and IIS looks for a folder of that name on disk. Angular owns routing AFTER
  index.html has loaded, so the server has to hand it index.html for anything that is
  not a real file — which is exactly what the rewrite below does. This is not a
  cosmetic fix: an owner cannot bookmark a report, send a colleague a link to an
  order journey, or press F5 without it.

  Lives in public/ so the Angular build copies it into the published output on every
  build. Adding it by hand to the deploy folder works once and is forgotten the next
  time somebody publishes.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <rule name="Angular routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Real files and folders are served as themselves; only unmatched
                 paths fall through to the app. Without these two conditions the
                 rewrite would swallow the JS bundles and the stylesheet too. -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- Removed first: IIS errors on a duplicate mapping if the server already
           defines one, which takes the whole site down rather than one file. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- index.html must never be cached: it names the hashed bundles, so a
             stale copy points at files a later publish has already deleted. The
             bundles themselves carry content hashes and are safe to cache. -->
        <add name="Cache-Control" value="no-cache" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
